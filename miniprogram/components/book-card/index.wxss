/* 书卡：参考闲鱼的竖向信息流版式，左边大图、右边三行信息 */
.bc {
  display: flex;
  background: #fff;
  border-radius: 20rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  position: relative;
  transition: transform 0.15s ease;
}

.bc:active { transform: scale(0.985); }

/* 高信用卖家的书：左边一条极细金线，不用文字标签 */
.bc.is-priority::before {
  content: '';
  position: absolute;
  left: 0;
  top: 26rpx;
  bottom: 26rpx;
  width: 4rpx;
  border-radius: 0 4rpx 4rpx 0;
  background: linear-gradient(180deg, #e8c67a, #c8901f);
}

.cover {
  width: 160rpx;
  height: 214rpx;
  border-radius: 12rpx;
  flex: none;
  margin-right: 22rpx;
  background: linear-gradient(150deg, #eef2ef, #e2e9e4);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  position: relative;
}

.cover-img {
  width: 100%;
  height: 100%;
  opacity: 0;
  transition: opacity .3s ease;
}

.cover-img.loaded { opacity: 1; }

.cover-text {
  font-size: 56rpx;
  color: rgba(47, 125, 91, 0.38);
  font-family: serif;
}

.info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  padding: 2rpx 0;
}

.title {
  font-size: 29rpx;
  font-weight: 600;
  color: #1f262d;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 元信息合并成一行，减少标签数量 */
.meta {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #9aa3ad;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.price-row {
  margin-top: auto;
  display: flex;
  align-items: baseline;
}

.p-cur {
  font-size: 36rpx;
  font-weight: 700;
  color: #2f7d5b;
  line-height: 1;
}

.p-sym { font-size: 24rpx; margin-right: 2rpx; }

.p-old {
  font-size: 22rpx;
  color: #b8b2a8;
  text-decoration: line-through;
  margin-left: 12rpx;
}

/* 折扣用百分比箭头，比"省xx%"更短 */
.p-off {
  font-size: 20rpx;
  color: #c0563f;
  margin-left: 10rpx;
}

.foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 10rpx;
}

.seller {
  font-size: 21rpx;
  color: #a8a299;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  flex: 1;
  min-width: 0;
}

.s-dot { margin: 0 8rpx; }

.match {
  font-size: 20rpx;
  color: #2f7d5b;
  background: #eef7f2;
  border-radius: 6rpx;
  padding: 3rpx 10rpx;
  flex: none;
  margin-left: 12rpx;
}
