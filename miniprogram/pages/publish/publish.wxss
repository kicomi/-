.card {
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 27rpx;
  font-weight: 650;
  margin-bottom: 24rpx;
}

.seg {
  display: flex;
  flex-wrap: wrap;
}

.seg-item {
  flex: 1;
  min-width: 120rpx;
  height: 68rpx;
  line-height: 68rpx;
  text-align: center;
  border: 1rpx solid #eee9e1;
  border-radius: 18rpx;
  font-size: 25rpx;
  color: #5b6470;
  margin: 0 10rpx 10rpx 0;
}

.seg-item.on {
  border-color: #2f7d5b;
  background: #e9f2ed;
  color: #2f7d5b;
  font-weight: 600;
}

.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.switch {
  width: 92rpx;
  height: 52rpx;
  border-radius: 26rpx;
  background: #e6e1d8;
  position: relative;
  transition: background 0.2s;
}

.switch.on { background: #2f7d5b; }

.knob {
  position: absolute;
  top: 6rpx;
  left: 6rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #fff;
  transition: transform 0.2s;
}

.switch.on .knob { transform: translateX(40rpx); }

.ta { height: 140rpx; }

.price-card {
  background: linear-gradient(160deg, #f2f8f4, #ffffff 60%);
  border: 1rpx solid #dcebe2;
}

.ai-btn {
  background: #2f7d5b;
  color: #fff;
  font-size: 24rpx;
  padding: 10rpx 22rpx;
  border-radius: 24rpx;
  font-weight: 600;
}

.price-empty {
  margin-top: 18rpx;
  font-size: 24rpx;
  color: #9aa3ad;
  line-height: 1.6;
}

.price-result { margin-top: 22rpx; }

.sug-row { display: flex; align-items: baseline; }

.sug-label {
  font-size: 25rpx;
  color: #5b6470;
  margin-right: 14rpx;
}

.sug-value {
  font-size: 52rpx;
  font-weight: 700;
  color: #2f7d5b;
}

.sug-range {
  font-size: 23rpx;
  color: #9aa3ad;
  margin: 4rpx 0 18rpx;
}

.tips {
  background: #fff;
  border: 1rpx solid #eee9e1;
  border-radius: 18rpx;
  padding: 18rpx 22rpx;
  margin-bottom: 20rpx;
}

.tip-line {
  font-size: 24rpx;
  color: #5b6470;
  line-height: 1.8;
}

.model-line {
  margin-top: 14rpx;
  text-align: center;
  font-size: 21rpx;
  color: #9aa3ad;
}

.notice {
  text-align: center;
  font-size: 22rpx;
  color: #9aa3ad;
  margin-top: 20rpx;
}

.photos {
  display: flex;
  flex-wrap: wrap;
}

.photo {
  position: relative;
  width: 152rpx;
  height: 152rpx;
  border-radius: 16rpx;
  overflow: hidden;
  margin: 0 16rpx 16rpx 0;
}

.photo-img { width: 100%; height: 100%; }

.photo-del {
  position: absolute;
  top: 0;
  right: 0;
  width: 40rpx;
  height: 40rpx;
  line-height: 36rpx;
  text-align: center;
  background: rgba(0, 0, 0, 0.5);
  color: #fff;
  font-size: 28rpx;
  border-bottom-left-radius: 12rpx;
}

.photo-add {
  width: 152rpx;
  height: 152rpx;
  border-radius: 16rpx;
  border: 1rpx dashed #d6d0c6;
  background: #fff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.plus { font-size: 44rpx; color: #b9b4ab; line-height: 1; }

.add-txt { font-size: 21rpx; color: #b9b4ab; margin-top: 8rpx; }

.photo-tip {
  font-size: 21rpx;
  color: #b9b4ab;
  margin-top: 4rpx;
  line-height: 1.5;
}
