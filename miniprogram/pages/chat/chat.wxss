.chat {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f7f4ef;
}

/* ---- 会话列表 ---- */
.conv {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.conv-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #e9f2ed;
  color: #2f7d5b;
  text-align: center;
  line-height: 88rpx;
  font-size: 32rpx;
  font-weight: 600;
  margin-right: 22rpx;
  flex: none;
  overflow: hidden;
}

.avatar-img { width: 100%; height: 100%; display: block; }

.conv-main { flex: 1; min-width: 0; }

.conv-top { display: flex; justify-content: space-between; align-items: baseline; }

.conv-name { font-size: 29rpx; font-weight: 600; }

.conv-time { font-size: 22rpx; color: #9aa3ad; }

.conv-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 8rpx;
}

.conv-last {
  font-size: 25rpx;
  color: #9aa3ad;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  max-width: 460rpx;
}

.badge {
  min-width: 34rpx;
  height: 34rpx;
  border-radius: 17rpx;
  background: #c0563f;
  color: #fff;
  font-size: 20rpx;
  text-align: center;
  line-height: 34rpx;
  padding: 0 8rpx;
}

/* ---- 顶部书籍条 ---- */
.book-bar {
  display: flex;
  align-items: center;
  background: #fff;
  padding: 18rpx 32rpx;
  border-bottom: 1rpx solid #f0ebe3;
}

.book-tag {
  font-size: 20rpx;
  color: #2f7d5b;
  background: #eef7f2;
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
  margin-right: 12rpx;
  flex: none;
}

.book-name {
  flex: 1;
  font-size: 25rpx;
  color: #3c444d;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.book-arrow { color: #b9b4ab; font-size: 28rpx; }

/* ---- 消息列表 ---- */
.msgs {
  flex: 1;
  padding: 24rpx 24rpx 8rpx;
  box-sizing: border-box;
}

.msg { margin-bottom: 32rpx; }

.msg-row { display: flex; align-items: flex-start; }

.msg-row.theirs { justify-content: flex-start; }

.msg-row.mine { justify-content: flex-end; }

/* 名字在头像上方，不再压在气泡顶上 */
.who {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 64rpx;
  flex: none;
}

.avatar-sm {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  overflow: hidden;
  background: #e9f2ed;
  color: #2f7d5b;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.msg-main {
  display: flex;
  flex-direction: column;
  max-width: 500rpx;
  margin: 0 16rpx;
}

.mine .msg-main { align-items: flex-end; }

/* 书目标签：透明底，只做弱提示，不再是一个白框 */
.bubble-book {
  font-size: 21rpx;
  color: #9aa3ad;
  background: transparent;
  border: none;
  padding: 0;
  margin-bottom: 8rpx;
}

.bubble {
  padding: 22rpx 28rpx;
  border-radius: 20rpx;
  font-size: 32rpx;
  font-weight: 500;
  line-height: 1.5;
  word-break: break-all;
}

.mine .bubble {
  background: #2f7d5b;
  color: #fff;
  border-bottom-right-radius: 6rpx;
}

.theirs .bubble {
  background: #fff;
  color: #14171a;
  border-bottom-left-radius: 6rpx;
  border: 1rpx solid #ece7df;
}

/* 时间戳去掉边框，弱化存在感 */
.time {
  font-size: 22rpx;
  color: #9aa3ad;
  background: transparent;
  border: none;
  padding: 0;
  margin-top: 10rpx;
}

/* ---- 输入区 ---- */
.input-bar {
  display: flex;
  align-items: center;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #eee9e1;
}

.msg-input {
  flex: 1;
  font-size: 30rpx;
  height: 78rpx;
  background: #f5f2ec;
  border-radius: 38rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
}

.send {
  margin-left: 18rpx;
  height: 76rpx;
  line-height: 76rpx;
  padding: 0 34rpx;
  border-radius: 38rpx;
  background: #2f7d5b;
  color: #fff;
  font-size: 27rpx;
  font-weight: 600;
}

.send.disabled { background: #b9cdc3; }

/* ---- 常用语 ---- */
.quick-bar {
  display: flex;
  flex-wrap: wrap;
  padding: 14rpx 24rpx 4rpx;
  background: #fff;
  border-top: 1rpx solid #eee9e1;
}

.quick-item {
  font-size: 23rpx;
  color: #5b6470;
  background: #f5f2ec;
  border-radius: 20rpx;
  padding: 8rpx 20rpx;
  margin: 0 14rpx 12rpx 0;
}

.quick-toggle {
  width: 60rpx;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  font-size: 32rpx;
  color: #9aa3ad;
}
