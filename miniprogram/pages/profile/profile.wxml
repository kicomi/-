<view class="profile">
  <view class="page">
    <view class="card avatar-card">
      <view class="avatar-wrap" bindtap="chooseAvatar">
        <image wx:if="{{previewAvatar}}" class="avatar-img" src="{{previewAvatar}}" mode="aspectFill" />
        <view wx:else class="avatar-txt">{{initial}}</view>
        <view class="avatar-mask">{{uploading ? '上传中…' : '换头像'}}</view>
      </view>
      <view class="avatar-tip">点击更换头像</view>
    </view>

    <view class="card">
      <view class="field">
        <text class="label">昵称</text>
        <input value="{{form.nickname}}" data-key="nickname" bindinput="onField" placeholder="取个好记的名字" />
      </view>
      <view class="field">
        <text class="label">个性签名</text>
        <textarea value="{{form.signature}}" data-key="signature" bindinput="onField"
                  placeholder="一句话介绍自己，比如：计科大三，专出教材" />
      </view>

      <view class="field">
        <text class="label">专业（可直接输入）</text>
        <input value="{{form.customMajor}}" data-key="customMajor" bindinput="onField"
               placeholder="例如：数据科学与大数据技术" />
        <view class="major-chips">
          <text class="major-chip" wx:for="{{majors}}" wx:key="id"
                data-name="{{item.name}}" bindtap="pickMajor">{{item.name}}</text>
        </view>
      </view>

      <view class="field">
        <text class="label">年级</text>
        <input value="{{form.grade}}" data-key="grade" bindinput="onField" placeholder="2024" />
      </view>
      <view class="field" style="margin-bottom:0">
        <text class="label">性别</text>
        <picker mode="selector" range="{{genders}}" value="{{genderIndex}}" bindchange="onGender">
          <view class="picker">{{genders[genderIndex]}}</view>
        </picker>
      </view>
    </view>

    <view class="btn btn-primary" bindtap="save" disabled="{{saving}}">
      {{saving ? '保存中…' : '保存'}}
    </view>
    <view class="tip">真实姓名与学号属于实名信息，注册后不可自行修改，仅管理员可见</view>
  </view>
</view>
