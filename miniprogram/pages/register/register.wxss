.card { margin-bottom: 24rpx; }

.card-title {
  font-size: 26rpx;
  font-weight: 650;
  margin-bottom: 20rpx;
  color: #2f7d5b;
}

.picker {
  height: 88rpx;
  line-height: 88rpx;
  background: #fff;
  border: 1rpx solid #eee9e1;
  border-radius: 20rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
}

.foot {
  text-align: center;
  font-size: 24rpx;
  color: #9aa3ad;
  margin-top: 28rpx;
}

.link { color: #2f7d5b; }

.major-chips {
  display: flex;
  flex-wrap: wrap;
  margin-top: 14rpx;
}

.major-chip {
  font-size: 22rpx;
  color: #2f7d5b;
  background: #eef7f2;
  border-radius: 20rpx;
  padding: 6rpx 18rpx;
  margin: 0 12rpx 12rpx 0;
}
