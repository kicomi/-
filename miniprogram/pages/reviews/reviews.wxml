<view class="reviews">
  <!-- 概况 -->
  <view class="summary" wx:if="{{summary}}">
    <view class="sum-left">
      <text class="avg">{{summary.avg || '—'}}</text>
      <text class="sum-total">{{summary.total}} 条评价</text>
    </view>
    <view class="sum-bars">
      <view class="bar-row" wx:for="{{summary.bars}}" wx:key="star">
        <text class="bar-label">{{item.star}} 星</text>
        <view class="bar-track">
          <view class="bar-fill" style="width: {{item.percent}}%"></view>
        </view>
        <text class="bar-count">{{item.count}}</text>
      </view>
    </view>
  </view>

  <!-- 骨架屏 -->
  <block wx:if="{{skeleton}}">
    <view class="sk" wx:for="{{[1,2,3]}}" wx:key="*this">
      <view class="sk-line w30"></view>
      <view class="sk-line w90"></view>
      <view class="sk-line w60"></view>
    </view>
  </block>

  <block wx:else>
    <view class="item" wx:for="{{rows}}" wx:key="id">
      <view class="item-head">
        <view class="avatar" data-uid="{{item.fromUserId}}" bindtap="goUser">{{item.initial}}</view>
        <view class="head-main">
          <text class="nick">{{item.fromNickname || '同学'}}</text>
          <view class="stars">
            <text class="star {{index < item.rating ? 'on' : ''}}" wx:for="{{[1,2,3,4,5]}}" wx:for-item="n"
                  wx:for-index="index" wx:key="*this">★</text>
          </view>
        </view>
        <text class="time">{{item.timeText}}</text>
      </view>

      <view class="content">{{item.content || '买家没有填写评价内容'}}</view>

      <view class="imgs" wx:if="{{item.imgs.length}}">
        <image wx:for="{{item.imgs}}" wx:for-item="img" wx:key="*this" class="img"
               src="{{img}}" mode="aspectFill" data-src="{{img}}" data-item="{{item}}" bindtap="preview" />
      </view>
    </view>

    <view wx:if="{{loadingMore}}" class="more">加载中…</view>
    <view wx:if="{{!hasMore && rows.length}}" class="more">没有更多了</view>

    <!-- 空状态：用 SVG 风格的几何图形代替 emoji -->
    <view wx:if="{{!rows.length}}" class="empty">
      <view class="empty-art">
        <view class="art-book"></view>
        <view class="art-line"></view>
        <view class="art-line short"></view>
      </view>
      <text class="empty-title">还没有人评价</text>
      <text class="empty-sub">买下这本书并完成交易后，可以留下你的评价</text>
    </view>
  </block>
</view>