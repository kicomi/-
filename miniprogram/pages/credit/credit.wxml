<view class="credit">
  <view class="hero">
    <view class="hero-label">当前信用分</view>
    <view class="score" style="color: {{credit.color}}">{{score}}</view>
    <view class="level" style="color: {{credit.color}}; border-color: {{credit.color}}">{{credit.name}}</view>

    <view class="track">
      <view class="fill" style="width: {{credit.percent}}%; background: {{credit.color}}"></view>
    </view>
    <view class="steps">
      <text class="step">青铜 70</text>
      <text class="step">白银 85</text>
      <text class="step">黄金 95</text>
    </view>

  </view>

  <view class="page">
    <view class="card">
      <view class="card-title"><text class="dot green"></text>怎么提高</view>
      <view class="rule" wx:for="{{gain}}" wx:key="title">
        <view class="rule-main">
          <view class="rule-title">{{item.title}}</view>
          <view class="rule-desc">{{item.desc}}</view>
        </view>
        <text class="delta plus">{{item.delta}}</text>
      </view>
    </view>

    <view class="card">
      <view class="card-title"><text class="dot red"></text>什么情况会扣分</view>
      <view class="rule" wx:for="{{loss}}" wx:key="title">
        <view class="rule-main">
          <view class="rule-title">{{item.title}}</view>
          <view class="rule-desc">{{item.desc}}</view>
        </view>
        <text class="delta minus">{{item.delta}}</text>
      </view>
    </view>

    <view class="footer">信用分 0-100，低于 60 分会被限制发布新书</view>
  </view>
</view>