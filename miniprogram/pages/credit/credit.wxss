.credit { min-height: 100vh; background: #f7f4ef; }

.hero {
  padding: 40rpx 32rpx 36rpx;
  background:
    radial-gradient(480rpx 260rpx at 82% -10%, #dcefe4 0%, transparent 65%),
    linear-gradient(180deg, #f2f8f5, #f7f4ef);
  text-align: center;
}

.hero-label { font-size: 23rpx; color: #8f9a94; }

.score {
  font-size: 96rpx;
  font-weight: 700;
  line-height: 1.1;
  margin: 10rpx 0 6rpx;
  letter-spacing: -2rpx;
}

.level {
  display: inline-block;
  font-size: 21rpx;
  border: 1rpx solid currentColor;
  border-radius: 8rpx;
  padding: 2rpx 12rpx;
}

.track {
  height: 12rpx;
  border-radius: 6rpx;
  background: #e8e4dc;
  overflow: hidden;
  margin: 28rpx 0 12rpx;
}

.fill { height: 100%; border-radius: 6rpx; transition: width 0.5s; }

.steps { display: flex; justify-content: space-between; }

.step { font-size: 19rpx; color: #b9b4ab; }

.next { font-size: 21rpx; color: #9aa3ad; margin-top: 14rpx; }

.note {
  background: #eef7f2;
  border-radius: 20rpx;
  padding: 22rpx 24rpx;
  font-size: 24rpx;
  color: #4a7a63;
  line-height: 1.7;
  margin-bottom: 24rpx;
}

.hl { font-weight: 700; color: #2f7d5b; }

.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 26rpx 28rpx;
  margin-bottom: 24rpx;
}

.card-title {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  font-weight: 650;
  margin-bottom: 20rpx;
}

.dot {
  width: 8rpx;
  height: 24rpx;
  border-radius: 4rpx;
  margin-right: 12rpx;
}

.dot.green { background: #2f7d5b; }
.dot.red { background: #c0563f; }

.rule {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f4f1eb;
}

.rule:last-child { border-bottom: none; }

.rule-main { flex: 1; min-width: 0; }

.rule-title { font-size: 26rpx; color: #1b1f23; }

.rule-desc { font-size: 21rpx; color: #9aa3ad; margin-top: 6rpx; line-height: 1.5; }

.delta {
  font-size: 28rpx;
  font-weight: 700;
  margin-left: 20rpx;
  flex: none;
}

.delta.plus { color: #2f7d5b; }
.delta.minus { color: #c0563f; }

.footer {
  text-align: center;
  font-size: 21rpx;
  color: #b9b4ab;
  padding: 8rpx 0 40rpx;
}

/* ---- 等级特权 ---- */
.perk-row {
  display: flex;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f2eee8;
}

.perk-row:last-child { border-bottom: none; }

.perk-level {
  width: 140rpx;
  font-size: 24rpx;
  font-weight: 650;
  color: #2f7d5b;
  flex: none;
}

.perk-items { flex: 1; }

.perk-item {
  display: block;
  font-size: 23rpx;
  color: #5b6470;
  line-height: 1.9;
}
