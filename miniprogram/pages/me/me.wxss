.me {
  min-height: 100vh;
  background:
    radial-gradient(520rpx 300rpx at 88% -6%, #dcefe4 0%, transparent 62%),
    linear-gradient(180deg, #f2f8f5 0%, #f7f4ef 320rpx);
}

/* ---- 标题栏 ---- */
.topbar {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  padding: 24rpx 32rpx 0;
}

.page-title {
  font-size: 38rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.top-actions { display: flex; align-items: center; }

.bell {
  position: relative;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.8);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
}

.bell-ico { font-size: 28rpx; }

.bell-badge {
  position: absolute;
  top: -4rpx;
  right: -4rpx;
  min-width: 30rpx;
  height: 30rpx;
  border-radius: 15rpx;
  background: #c0563f;
  color: #fff;
  font-size: 18rpx;
  line-height: 30rpx;
  text-align: center;
  padding: 0 6rpx;
}

.gear {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.8);
  color: #5b6470;
  font-size: 30rpx;
  text-align: center;
  line-height: 64rpx;
}

/* ---- 用户卡 ---- */
.user-card {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx 8rpx;
}

.avatar {
  width: 136rpx;
  height: 136rpx;
  border-radius: 50%;
  overflow: hidden;
  flex: none;
  margin-right: 24rpx;
  background: #e3f0e8;
  border: 4rpx solid #fff;
  box-shadow: 0 14rpx 34rpx -18rpx rgba(47, 125, 91, 0.8);
}

.avatar-img { width: 100%; height: 100%; }

.avatar-txt {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  color: #2f7d5b;
  font-weight: 600;
}

.u-main { flex: 1; min-width: 0; }

.u-row { display: flex; align-items: center; }

.u-name {
  font-size: 36rpx;
  font-weight: 700;
  margin-right: 14rpx;
  max-width: 300rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.u-level {
  font-size: 20rpx;
  border: 1rpx solid currentColor;
  border-radius: 8rpx;
  padding: 1rpx 10rpx;
}

.u-sub { font-size: 24rpx; color: #8f9a94; margin-top: 8rpx; }

.u-sign {
  font-size: 24rpx;
  color: #6b756f;
  margin-top: 8rpx;
  line-height: 1.5;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.login-btn {
  display: inline-block;
  margin-top: 14rpx;
  height: 60rpx;
  line-height: 60rpx;
  padding: 0 34rpx;
  border-radius: 30rpx;
  background: #2f7d5b;
  color: #fff;
  font-size: 26rpx;
}

/* ---- 信用卡 ---- */
.credit-card {
  margin: 20rpx 32rpx 0;
  background: #fff;
  border-radius: 28rpx;
  padding: 30rpx 30rpx 24rpx;
  box-shadow: 0 12rpx 32rpx -26rpx rgba(27, 31, 35, 0.75);
}

.card-hover {
  background: #faf8f4;
  transform: scale(0.993);
}

.c-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.c-left { display: flex; align-items: baseline; }

.c-label { font-size: 24rpx; color: #8f9a94; }

.c-score {
  font-size: 54rpx;
  font-weight: 700;
  margin-left: 10rpx;
  line-height: 1;
}

.c-level {
  font-size: 22rpx;
  border: 1rpx solid currentColor;
  border-radius: 8rpx;
  padding: 2rpx 12rpx;
}

.c-track {
  height: 12rpx;
  border-radius: 6rpx;
  background: #f0ebe3;
  overflow: hidden;
  margin: 22rpx 0 12rpx;
}

.c-fill {
  height: 100%;
  border-radius: 6rpx;
  transition: width 0.4s;
}

.c-steps { display: flex; justify-content: space-between; }

.step { font-size: 20rpx; color: #b9b4ab; }

.step.on { color: #2f7d5b; font-weight: 600; }

.c-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #f4f1eb;
}

.c-hint { font-size: 22rpx; color: #9aa3ad; }

.c-more { font-size: 22rpx; color: #2f7d5b; font-weight: 600; }

/* ---- 数据条 ---- */
.stats {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 24rpx;
  padding: 26rpx 0;
  margin-top: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 10rpx 28rpx -24rpx rgba(27, 31, 35, 0.6);
}

.stat { flex: 1; display: flex; flex-direction: column; align-items: center; }

.divider { width: 1rpx; height: 44rpx; background: #f0ebe3; }

.num { font-size: 38rpx; font-weight: 700; position: relative; }

.dot-red {
  display: inline-block;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #c0563f;
  vertical-align: super;
  margin-left: 4rpx;
}

.lbl { font-size: 22rpx; color: #9aa3ad; margin-top: 6rpx; }

/* ---- 快捷入口 ---- */
.quick {
  display: flex;
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx 0;
  margin-bottom: 24rpx;
}

.quick-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.q-ico { font-size: 34rpx; }

.q-txt { font-size: 22rpx; color: #5b6470; }

/* ---- 标签页 ---- */
.tabs { display: flex; margin-bottom: 20rpx; }

.tab {
  font-size: 28rpx;
  color: #9aa3ad;
  margin-right: 36rpx;
  padding-bottom: 10rpx;
  position: relative;
}

.tab.on { color: #1b1f23; font-weight: 650; }

.tab.on::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 0;
  transform: translateX(-50%);
  width: 40rpx;
  height: 6rpx;
  border-radius: 4rpx;
  background: #2f7d5b;
}

.logout {
  margin-top: 36rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: #fff;
  border-radius: 24rpx;
  font-size: 28rpx;
  color: #c0563f;
}

/* ---- 信用规则（内联展开） ---- */
.rules {
  margin: 20rpx 32rpx 0;
  background: #fff;
  border-radius: 28rpx;
  padding: 26rpx 28rpx 20rpx;
  box-shadow: 0 12rpx 32rpx -26rpx rgba(27, 31, 35, 0.75);
}

.rules-note {
  background: #eef7f2;
  border-radius: 16rpx;
  padding: 18rpx 20rpx;
  font-size: 24rpx;
  color: #4a7a63;
  line-height: 1.7;
  margin-bottom: 22rpx;
}

.hl { font-weight: 700; color: #2f7d5b; }

.rule-group-title {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  font-weight: 650;
  margin: 8rpx 0 10rpx;
}

.bar {
  width: 7rpx;
  height: 22rpx;
  border-radius: 4rpx;
  margin-right: 12rpx;
}

.bar.green { background: #2f7d5b; }
.bar.red { background: #c0563f; }

.rule {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f4f1eb;
}

.rule:last-of-type { border-bottom: none; }

.rule-name { font-size: 26rpx; color: #3c444d; flex: 1; }

.delta { font-size: 28rpx; font-weight: 700; margin-left: 16rpx; }

.delta.plus { color: #2f7d5b; }
.delta.minus { color: #c0563f; }

.rules-foot {
  text-align: center;
  font-size: 20rpx;
  color: #b9b4ab;
  margin-top: 16rpx;
}

/* 快捷入口上的未读角标 */
.q-ico { position: relative; }

.q-dot {
  position: absolute;
  top: -6rpx;
  right: -20rpx;
  min-width: 28rpx;
  height: 28rpx;
  border-radius: 14rpx;
  background: #c0563f;
  color: #fff;
  font-size: 18rpx;
  line-height: 28rpx;
  text-align: center;
  padding: 0 6rpx;
}

/* ---- 信用等级外观 ---- */
.credit-card { position: relative; overflow: hidden; }

/* 等级光环：从中心向外扩散的柔光 */
.halo {
  position: absolute;
  top: -80rpx;
  right: -60rpx;
  width: 320rpx;
  height: 320rpx;
  pointer-events: none;
}

/* 等级宝石：用纯 CSS 画一个旋转 45° 的方块，比 emoji 干净 */
.c-gem {
  width: 16rpx;
  height: 16rpx;
  border-radius: 3rpx;
  transform: rotate(45deg);
  margin-right: 14rpx;
  flex: none;
}

/* 黄金：香槟金渐变，克制一点，不要发光乱闪 */
.tier-gold {
  background:
    radial-gradient(120% 90% at 100% 0%, rgba(255, 236, 190, .55) 0%, transparent 58%),
    linear-gradient(160deg, #fffdf7 0%, #fdf6e3 46%, #fffefb 100%);
  border: 1rpx solid #ecd9a8;
  box-shadow: 0 10rpx 30rpx -26rpx rgba(178, 126, 32, .7);
}

/* 金边上的一道细高光，静态的，不抢视线 */
.tier-gold::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, rgba(226, 183, 90, .9), transparent);
}

/* 白银：冷灰蓝渐变 */
.tier-silver {
  background: linear-gradient(135deg, #fbfcfe 0%, #eef2f7 60%, #ffffff 100%);
  border: 1rpx solid #e2e8f0;
}

/* 青铜：暖棕 */
.tier-bronze {
  background: linear-gradient(135deg, #fffaf5 0%, #f7ece2 60%, #ffffff 100%);
  border: 1rpx solid #eee0d2;
}

/* 低分：淡红提醒 */
.tier-low {
  background: linear-gradient(135deg, #fff8f7 0%, #fdeceb 60%, #ffffff 100%);
  border: 1rpx solid #f2d3ce;
}

/* ---- 特权清单 ---- */
.perks { display: flex; flex-wrap: wrap; margin-top: 16rpx; }

.perk {
  font-size: 20rpx;
  color: #b9b4ab;
  background: #f4f1ec;
  border-radius: 18rpx;
  padding: 6rpx 16rpx;
  margin: 0 12rpx 8rpx 0;
}

.perk.on {
  color: #2f7d5b;
  background: #e9f2ed;
}